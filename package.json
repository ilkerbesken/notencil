{
  "name": "notencil",
  "version": "1.2.03",
  "description": "Profesyonel Dijital Beyaz Tahta ve Not Alma Uygulaması",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:web": "echo 'Web sürümü hazır.'",
    "build:ios": "mkdir -p www && cp -r index.html style.css calendar.css manifest.json js css assets locales templates www/ && npx cap copy ios",
    "dist": "electron-builder"
  },
  "author": "notencil",
  "license": "Apache-2.0",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.notencil.app",
    "productName": "notencil",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist",
      "!node_modules",
      "!.github",
      "!test_script.js",
      "!tab-test.html"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": [
          "x64",
          "arm64"
        ]
      }
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.3.0"
  }
}
