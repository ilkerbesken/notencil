<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-notencil">
    <comment>Notencil Note File</comment>
    <comment xml:lang="tr">Notencil Not Dosyası</comment>
    <glob pattern="*.ncil"/>
    <magic priority="50">
      <match type="string" offset="0" value="NOTENCIL!"/>
    </magic>
    <icon name="application-x-notencil"/>
  </mime-type>
</mime-info>
